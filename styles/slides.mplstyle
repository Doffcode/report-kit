# matplotlib style for slide charts: wide, big text, no chart junk.
# In slides/charts/*.py:  plt.style.use(os.path.expanduser("~/report-kit/styles/slides.mplstyle"))
figure.figsize: 12, 5.6
figure.dpi: 100
savefig.dpi: 200
savefig.bbox: tight
font.family: sans-serif
font.sans-serif: Calibri, Carlito, Liberation Sans, DejaVu Sans
font.size: 20
axes.titlesize: 22
axes.labelsize: 20
xtick.labelsize: 18
ytick.labelsize: 18
legend.fontsize: 18
legend.frameon: False
axes.spines.top: False
axes.spines.right: False
axes.grid: True
grid.color: "#D9D9D9"
grid.linewidth: 0.8
lines.linewidth: 3
lines.markersize: 7
axes.prop_cycle: cycler('color', ['2E6DB4', 'E07A1F', '2A9D8F', '8E5BA8', 'C0392B', '7F8C8D'])
